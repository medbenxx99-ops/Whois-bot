# Telegram: create a bot with @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Your numeric Telegram user ID (not username)
TELEGRAM_ALLOWED_USER_ID=

# Who.is API key. Never commit the real key.
WHOIS_API_KEY=

# Upstash Redis REST credentials (persistent cache + monthly counter)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Set this after the first Vercel deployment, e.g. https://your-project.vercel.app
APP_URL=
